#include <stdio.h>
void displayArray(int arr[], int size) {
    printf("Array elements are: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}
int main() {
    int myNumbers[] = {10, 20, 30, 40, 50};
    int n = 5;
   displayArray(myNumbers, n);
    return 0;
}
