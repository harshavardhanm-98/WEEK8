#include <stdio.h>
// Function declaration
int findSum(int a, int b);
int main() {
    int num1, num2, res;
    printf("Enter two numbers: ");
    scanf("%d %d", &num1, &num2);
    res = findSum(num1, num2);
    printf("Sum = %d\n", res);
    return 0;
}
// Function definition
int findSum(int a, int b) {
    return a + b;
}

